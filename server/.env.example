NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=debug

SITE_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

MONGODB_URI=mongodb://127.0.0.1:27017/ai-in-action

JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=aia_rt
COOKIE_SECURE=false
COOKIE_DOMAIN=

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

MEDIA_STORAGE_DRIVER=local
MEDIA_MAX_FILE_SIZE_MB=25
LOCAL_UPLOAD_DIR=uploads

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ai-in-action

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SEED_ADMIN_NAME=AI IN ACTION Admin
SEED_ADMIN_EMAIL=admin@aiinaction.local
SEED_ADMIN_PASSWORD=ChangeMe@12345
